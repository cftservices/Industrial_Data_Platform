            "uid": "vla-tdengine"
          },
          "queryType": "SQL",
          "formatType": "Time series",
          "sql": "select _wstart as ts, avg(`value`) as cool_c from idp.telemetry where `topic`='DairyWorks/Vla/Cooling/cooler-01/Status/temp_C' and _ts >= $from and _ts <= $to interval(5s) fill(prev)"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
