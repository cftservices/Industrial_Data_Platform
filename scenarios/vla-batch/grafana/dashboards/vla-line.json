{
  "uid": "vla-line",
  "id": null,
  "version": 2,
  "title": "VLA Line — Live (DairyWorks)",
  "description": "Live line view of the DairyWorks vla batch demo, read from the TDengine historian (idp.telemetry, fed by the MQTT bridge from DairyWorks/Vla/#). Setpoints (cook 88 C, cool 22 C, hold 300 s) and dose targets are drawn from the recipe in factory/physics.py, not from the UNS: those tags barely change so they carry no usable history.",
  "tags": [
    "vla-batch",
    "dairyworks",
    "milkdemo"
  ],
  "timezone": "Europe/Amsterdam",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Batch state",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "tdengine-datasource",
        "uid": "vla-tdengine"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tdengine-datasource",
            "uid": "vla-tdengine"
          },
          "queryType": "SQL",
          "formatType": "Table",
          "sql": "select last(`valuestr`) as batch_state from idp.telemetry where `topic`='DairyWorks/Vla/Batch/Status/state'"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "IDLE": {
                  "text": "IDLE",
                  "color": "#6b7280",
                  "index": 0
                },
                "DOSING": {
                  "text": "DOSING",
                  "color": "#3b82f6",
                  "index": 1
                },
                "COOKING": {
                  "text": "COOKING",
                  "color": "#f59e0b",
                  "index": 2
                },
                "COOLING": {
