          "sql": "select _wstart as ts, avg(`value`) as mix_c from idp.telemetry where `topic`='DairyWorks/Vla/Mixing/process-tank-01/Status/temp_C' and _ts >= $from and _ts <= $to interval(5s) fill(prev)"
        },
