    {
      "id": 20,
      "type": "timeseries",
      "title": "Temperatures — cook / mix / cool",
      "description": "Dashed lines are the recipe setpoints: 88 C cook, 22 C cool target. Those come from physics.py RECIPES, not from the UNS — setpoint_C and target_C barely change so they carry no usable history.",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "tdengine-datasource",
        "uid": "vla-tdengine"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tdengine-datasource",
            "uid": "vla-tdengine"
          },
          "queryType": "SQL",
          "formatType": "Time series",
          "sql": "select _wstart as ts, avg(`value`) as cook_c from idp.telemetry where `topic`='DairyWorks/Vla/Cook/cook-unit-01/Status/temp_C' and _ts >= $from and _ts <= $to interval(5s) fill(prev)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "tdengine-datasource",
            "uid": "vla-tdengine"
          },
          "queryType": "SQL",
