    {
      "id": 10,
      "type": "state-timeline",
      "title": "Batch lifecycle",
      "description": "Every batch in the window side by side. The HTML demo only shows the current step; this shows how long each phase actually took. Each phase runs about 30 s, a full batch about 120 s. Both rows come straight from the factory over OPC-UA, so they fill regardless of whether the MES is involved.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 4
      },
      "datasource": {
        "type": "tdengine-datasource",
        "uid": "vla-tdengine"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tdengine-datasource",
            "uid": "vla-tdengine"
          },
          "queryType": "SQL",
          "formatType": "Time series",
          "sql": "select _wstart as ts, last(`valuestr`) as line_state from idp.telemetry where `topic`='DairyWorks/Vla/Batch/Status/state' and _ts >= $from and _ts <= $to interval(10s) fill(prev)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "tdengine-datasource",
            "uid": "vla-tdengine"
          },
          "queryType": "SQL",
