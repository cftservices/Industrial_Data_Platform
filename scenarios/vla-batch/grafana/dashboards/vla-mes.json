    "vla-batch",
    "dairyworks",
    "internal",
    "engineering"
  ],
  "timezone": "Europe/Amsterdam",
  "editable": true,
  "graphTooltip": 0,
  "refresh": "30s",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "days",
        "label": "Period (days)",
        "type": "custom",
        "query": "1,7,30",
        "current": {
          "text": "7",
          "value": "7"
        },
        "options": [
          {
            "text": "1",
            "value": "1",
            "selected": false
          },
          {
            "text": "7",
            "value": "7",
            "selected": true
          },
          {
            "text": "30",
            "value": "30",
            "selected": false
          }
        ],
        "hide": 0
      }
    ]
  },
